# Copy this file to .env.local and fill in values as needed.
# Without any configuration the app runs entirely on mock data — no API keys required.

# ── Global override ──────────────────────────────────────────────────────────
# Set to "true" to force ALL providers to use mock implementations,
# regardless of any individual AI_PROVIDER / FIGMA_PROVIDER / SCREENSHOT_PROVIDER settings.
USE_MOCKS=true

# ── AI Analysis ──────────────────────────────────────────────────────────────
# Options: mock (default) | claude | openai
AI_PROVIDER=mock

# Required when AI_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Required when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Figma Export ─────────────────────────────────────────────────────────────
# Options: mock (default) | figma
FIGMA_PROVIDER=mock

# Required when FIGMA_PROVIDER=figma
# FIGMA_ACCESS_TOKEN=figd_...

# ── URL Screenshot ────────────────────────────────────────────────────────────
# Options: mock (default) | playwright
SCREENSHOT_PROVIDER=mock

# No extra key needed for playwright — run `npx playwright install chromium` first.
